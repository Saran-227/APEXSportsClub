# ==============================================================================
# Sports Club Management System (SCMS) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as required for your environment.
# DO NOT commit .env containing production secrets to version control.

# Application Configuration
APP_NAME="Sports Club Management System"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=insecure_change_this_to_a_cryptographically_secure_key_32_bytes_min

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=apexsportsclub
POSTGRES_USER=apex_admin
POSTGRES_PASSWORD=your_secure_postgres_password

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# Optional: Override complete Database URL (defaults to constructed URL from above)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://apex_admin:your_secure_postgres_password@localhost:5432/apexsportsclub

# Session & Cookie Security
SESSION_COOKIE_NAME="scms_session"
SESSION_EXPIRE_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=1800
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# Anti-CSRF Protection
CSRF_COOKIE_NAME="scms_csrf_token"
CSRF_HEADER_NAME="X-CSRF-Token"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-actual-client-id
GOOGLE_CLIENT_SECRET=your-actual-client-secret
GOOGLE_REDIRECT_URI="http://localhost:5174/api/auth/callback/google"

