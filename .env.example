# ApexSportsClub Environment Configuration Example

# Application
APP_NAME="ApexSportsClub"
APP_ENV="development"
APP_DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="super_secret_cryptographically_secure_key_32_bytes_min"

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="sports_club_db"
POSTGRES_USER="scms_user"
POSTGRES_PASSWORD="scms_secure_password"

# Optional direct connection override (e.g. for development or testing)
# DATABASE_URL="postgresql+psycopg://scms_user:scms_secure_password@localhost:5432/sports_club_db"

# Session & Cookie Security
SESSION_COOKIE_NAME="scms_session"
SESSION_EXPIRE_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=1800
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# Anti-CSRF Protection
CSRF_COOKIE_NAME="scms_csrf_token"
CSRF_HEADER_NAME="X-CSRF-Token"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-actual-client-id
GOOGLE_CLIENT_SECRET=your-actual-client-secret
GOOGLE_REDIRECT_URI="http://localhost:5174/api/auth/callback/google"
